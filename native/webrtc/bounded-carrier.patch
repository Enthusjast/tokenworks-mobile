+  auto ack = [&](TSN cumulative, std::vector<SackChunk::GapAckBlock> gaps) {
+    a.socket.ReceivePacket(SctpPacket::Builder(a.socket.verification_tag(), a.options)
+        .Add(SackChunk(cumulative, 0xffffffffu, std::move(gaps), {})).Build());
+  };
+  ack(TSN(*sent.front() - 1), {{2, 4}});
+  EXPECT_EQ(a.socket.Send(DcSctpMessage(StreamID(1), PPID(53), std::vector<uint8_t>(1)), kSendOptions), SendStatus::kErrorResourceExhaustion);
+  ack(TSN(*sent.front() - 1), {{2, 4}});
+  testing::Mock::VerifyAndClearExpectations(&a.cb);
+  EXPECT_CALL(a.cb, OnTotalBufferedAmountLow()).Times(1);
+  ack(sent.back(), {});
+  ack(sent.back(), {});
+  testing::Mock::VerifyAndClearExpectations(&a.cb);
+  for (uint32_t i = 1; i <= 64; ++i) {
+    ASSERT_EQ(a.socket.Send(DcSctpMessage(StreamID(1), PPID(53), std::vector<uint8_t>(512)), kSendOptions), SendStatus::kSuccess);
+    ASSERT_FALSE(a.cb.ConsumeSentPacket().empty());
+    ack(TSN(*sent.back() + i), {});
+  }
+  EXPECT_EQ(a.socket.buffered_amount(StreamID(1)), 0u);
+  a.socket.Close();
+  EXPECT_EQ(a.socket.state(), SocketState::kClosed);
+}
+
+TEST(DcSctpSocketTest, NativeCarrierRetainedMetadataBackpressuresTinyMessages) {
+  DcSctpOptions options = {.max_total_send_buffer_size = 2048, .max_retained_send_chunks = 2};
+  SocketUnderTest a("bounded-metadata", options), z("receiver");
+  ConnectSockets(a, z);
+  std::vector<TSN> sent;
+  for (int i = 0; i < 2; ++i) {
+    ASSERT_EQ(a.socket.Send(DcSctpMessage(StreamID(1), PPID(53), {42}), kSendOptions), SendStatus::kSuccess);
+    ASSERT_HAS_VALUE_AND_ASSIGN(SctpPacket packet, SctpPacket::Parse(a.cb.ConsumeSentPacket(), a.options));
+    ASSERT_HAS_VALUE_AND_ASSIGN(DataChunk chunk, DataChunk::Parse(packet.descriptors()[0].data));
+    sent.push_back(chunk.tsn());
+  }
+  ASSERT_EQ(a.socket.Send(DcSctpMessage(StreamID(1), PPID(53), {42}), kSendOptions), SendStatus::kSuccess);
+  EXPECT_EQ(a.socket.buffered_amount(StreamID(1)), 1u);
+  EXPECT_TRUE(a.cb.ConsumeSentPacket().empty());
+  a.socket.ReceivePacket(SctpPacket::Builder(a.socket.verification_tag(), a.options)
+      .Add(SackChunk(sent.front(), 0xffffffffu, {}, {})).Build());
+  EXPECT_EQ(a.socket.buffered_amount(StreamID(1)), 0u);
+  EXPECT_FALSE(a.cb.ConsumeSentPacket().empty());
+}
+
+TEST(DcSctpSocketTest, NativeCarrierCanceledTaskKeepsCreditsUntilDestruction) {
+  webrtc::QueuedResourceBudget budget(1, 128);
+  webrtc::ScopedTaskSafety lifetime;
+  bool called = false;
+  auto credit = budget.Reserve(128);
+  ASSERT_TRUE(credit.has_value());
+  absl::AnyInvocable<void() &&> task = webrtc::SafeTask(
+      lifetime.flag(), [credit = std::move(*credit), &called]() { called = true; });
+  lifetime.flag()->SetNotAlive();
+  EXPECT_FALSE(budget.Reserve(0).has_value());
+  std::move(task)();
+  EXPECT_FALSE(called);
+  task = nullptr;
+  EXPECT_TRUE(budget.Reserve(128).has_value());
+}
+
+TEST(DcSctpSocketTest, NativeCarrierQueueCreditsCountBytesAndMoveExactlyOnce) {
+  webrtc::QueuedResourceBudget budget(2, 5);
+  auto first = budget.Reserve(3);
+  auto second = budget.Reserve(2);
+  ASSERT_TRUE(first.has_value());
+  ASSERT_TRUE(second.has_value());
+  EXPECT_FALSE(budget.Reserve(0).has_value());
+  first.reset();
+  EXPECT_FALSE(budget.Reserve(4).has_value());
+  auto replacement = budget.Reserve(3);
+  ASSERT_TRUE(replacement.has_value());
+  second.reset();
+  replacement.reset();
+  EXPECT_TRUE(budget.Reserve(5).has_value());
+}

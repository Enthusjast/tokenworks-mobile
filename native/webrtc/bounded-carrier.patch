+TEST_F(ReassemblyQueueTest, NativeCarrierReservesActualRemainingReceiveBytes) {
+  ReassemblyQueue reasm("bounded", 1024, false, 2);
+  reasm.Add(TSN(10), gen_.Ordered(std::vector<uint8_t>(1020), "B"));
+  EXPECT_EQ(reasm.queued_bytes(), 1020u);
+  EXPECT_EQ(reasm.remaining_bytes(), 0u);
+  reasm.Add(TSN(11), gen_.Ordered(std::vector<uint8_t>(5), "E"));
+  EXPECT_TRUE(reasm.resource_exhausted());
+  EXPECT_EQ(reasm.queued_bytes(), 1020u);
+}
+
+TEST_F(ReassemblyQueueTest, NativeCarrierZeroPayloadDeferredControlIsBounded) {
+  ReassemblyQueue reasm("bounded-control", 256 * 1024, false, 2);
+  StreamID ids[] = {StreamID(1)};
+  reasm.EnterDeferredReset(TSN(10), ids);
+  for (uint32_t i = 0; i < 128; ++i) {
+    reasm.HandleForwardTsn(TSN(11 + i), {});
+    ASSERT_FALSE(reasm.resource_exhausted());
+    ASSERT_EQ(reasm.queued_bytes(), 0u);
+  }
+  reasm.HandleForwardTsn(TSN(139), {});
+  EXPECT_TRUE(reasm.resource_exhausted());
+  EXPECT_EQ(reasm.queued_bytes(), 0u);
+}
+
+TEST_F(ReassemblyQueueTest, NativeCarrierRejectsUnnegotiatedStreamMetadata) {
+  ReassemblyQueue reasm("bounded-streams", 1024, false, 2);
+  reasm.Add(TSN(10), gen_.Ordered({42}, "BE", {.stream_id = StreamID(2)}));
+  EXPECT_TRUE(reasm.resource_exhausted());
+  EXPECT_EQ(reasm.queued_bytes(), 0u);
+}
+
+TEST_F(ReassemblyQueueTest, NativeCarrierFragmentSlotsReleaseOnRealForwardDiscard) {
+  ReassemblyQueue reasm("bounded-fragments", 256 * 1024, false, 2);
+  for (uint32_t i = 0; i < 1024; ++i) {
+    reasm.Add(TSN(10 + i), gen_.Ordered({42}, "", {.mid = MID(1)}));
+    ASSERT_FALSE(reasm.resource_exhausted());
+  }
+  EXPECT_EQ(reasm.queued_bytes(), 1024u);
+  SkippedStream skipped[] = {{StreamID(1), SSN(1)}};
+  reasm.HandleForwardTsn(TSN(1033), skipped);
+  EXPECT_EQ(reasm.queued_bytes(), 0u);
+  for (uint32_t i = 0; i < 1024; ++i) {
+    reasm.Add(TSN(1034 + i), gen_.Ordered({42}, "", {.mid = MID(3)}));
+    ASSERT_FALSE(reasm.resource_exhausted());
+  }
+  reasm.Add(TSN(2058), gen_.Ordered({42}, "", {.mid = MID(3)}));
+  EXPECT_TRUE(reasm.resource_exhausted());
+  EXPECT_EQ(reasm.queued_bytes(), 1024u);
+}

diff --git a/rtc_base/queued_resource_budget.h b/rtc_base/queued_resource_budget.h
new file mode 100644
--- /dev/null
+++ b/rtc_base/queued_resource_budget.h
@@ -0,0 +1,81 @@
+/*
+ * Copyright 2026 TokenWorks contributors. All rights reserved.
+ * Use of this source code is governed by a BSD-style license that can be
+ * found in the LICENSE file in the root of the source tree.
+ */
+#ifndef RTC_BASE_QUEUED_RESOURCE_BUDGET_H_
+#define RTC_BASE_QUEUED_RESOURCE_BUDGET_H_
+
+#include <atomic>
+#include <cstddef>
+#include <memory>
+#include <optional>
+#include <utility>
+
+namespace webrtc {
+
+// A credit lives in the queued closure, including cancellation, until its real destruction.
+class QueuedResourceBudget final {
+ private:
+  struct State {
+    State(size_t count_limit, size_t byte_limit)
+        : count_limit(count_limit), byte_limit(byte_limit) {}
+    const size_t count_limit;
+    const size_t byte_limit;
+    std::atomic<size_t> count{0};
+    std::atomic<size_t> bytes{0};
+  };
+
+ public:
+  class Ticket final {
+   public:
+    Ticket(std::shared_ptr<State> state, size_t bytes)
+        : state_(std::move(state)), bytes_(bytes) {}
+    Ticket(Ticket&&) = default;
+    Ticket& operator=(Ticket&& other) noexcept {
+      if (this != &other) {
+        Release();
+        state_ = std::move(other.state_);
+        bytes_ = other.bytes_;
+      }
+      return *this;
+    }
+    Ticket(const Ticket&) = delete;
+    Ticket& operator=(const Ticket&) = delete;
+    ~Ticket() { Release(); }
+
+   private:
+    void Release() {
+      if (state_) {
+        state_->bytes.fetch_sub(bytes_);
+        state_->count.fetch_sub(1);
+        state_.reset();
+      }
+    }
+    std::shared_ptr<State> state_;
+    size_t bytes_;
+  };
+
+  QueuedResourceBudget(size_t count_limit, size_t byte_limit)
+      : state_(std::make_shared<State>(count_limit, byte_limit)) {}
+
+  std::optional<Ticket> Reserve(size_t bytes) {
+    if (bytes > state_->byte_limit) return std::nullopt;
+    if (state_->count.fetch_add(1) >= state_->count_limit) {
+      state_->count.fetch_sub(1);
+      return std::nullopt;
+    }
+    const size_t prior = state_->bytes.fetch_add(bytes);
+    if (prior > state_->byte_limit - bytes) {
+      state_->bytes.fetch_sub(bytes);
+      state_->count.fetch_sub(1);
+      return std::nullopt;
+    }
+    return Ticket(state_, bytes);
+  }
+
+ private:
+  const std::shared_ptr<State> state_;
+};
+}  // namespace webrtc
+#endif  // RTC_BASE_QUEUED_RESOURCE_BUDGET_H_

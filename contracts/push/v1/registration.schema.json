{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokenworks-mobile:push:registration:v1",
  "description": "Authenticated registered-device FCM binding. The server binds the supplied local account and verified organization to the current user/device and deployment, and checks the canonical full-owner fingerprint. Rotation replaces the old binding and cancels its pending references. Provider tokens are encrypted at rest and never logged.",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider", "token", "account_id", "organization_id", "deployment_sha256", "owner_fingerprint"],
  "properties": {
    "provider": {"type": "string", "const": "fcm"},
    "token": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[!-~]+$"},
    "account_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "organization_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "deployment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "owner_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

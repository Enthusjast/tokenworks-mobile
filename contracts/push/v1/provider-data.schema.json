{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokenworks-mobile:push:provider-data:v1",
  "description": "FCM HTTP v1 data-only minimal reference. Every value is a string. No notification title/body, arguments, questions, prompts, audio, file contents or execution authority. Full owner scope is freshly bound at registration and reauthorized at actual send; expiry must be future and no more than 15 minutes. Opening requires current native authorization/state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "binding_id", "notification_id", "account_id", "organization_id", "deployment_sha256", "user_id", "device_id", "owner_fingerprint", "runtime_id", "session_id", "kind", "expires_at"],
  "properties": {
    "v": {"type": "string", "const": "1"},
    "binding_id": {"$ref": "#/$defs/uuid"},
    "notification_id": {"$ref": "#/$defs/uuid"},
    "account_id": {"$ref": "#/$defs/uuid"},
    "organization_id": {"$ref": "#/$defs/uuid"},
    "deployment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "user_id": {"$ref": "#/$defs/uuid"},
    "device_id": {"$ref": "#/$defs/uuid"},
    "owner_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_id": {"$ref": "#/$defs/uuid"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u0020\\u007f]+$"},
    "kind": {"type": "string", "enum": ["interaction", "completed"]},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  }
}

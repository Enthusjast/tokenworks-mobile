{
  "name": "tokenworks-mobile",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "host/remote-control"
  ],
  "scripts": {
    "dev": "python3 tools/dev/local.py start",
    "dev:probe": "node tools/dev/smoke.mjs",
    "dev:status": "python3 tools/dev/local.py status",
    "dev:stop": "python3 tools/dev/local.py stop",
    "build": "npm run build --workspaces",
    "build:noise": "python3 tools/native/build-noise.py all",
    "test:noise": "python3 tools/native/test-noise.py",
    "contracts:typert": "tsx tools/generate-typert-contract.ts",
    "contracts:product-access": "tsx tools/generate-product-access.ts",
    "contracts:product-access:check": "tsx tools/generate-product-access.ts --check",
    "prepare:rtc": "node host/remote-control/scripts/patch-werift.mjs",
    "precheck": "npm run prepare:rtc",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test host/remote-control/tests/*.test.ts",
    "verify": "npm run contracts:typert:check && npm run contracts:product-access:check && npm run check && npm run build",
    "test:android": "cd android && ./gradlew --max-workers=2 -Dorg.gradle.parallel=false check",
    "test:android:core": "cd android && ./gradlew --max-workers=2 -Dorg.gradle.parallel=false -PjvmOnly=true check",
    "contracts:typert:check": "tsx tools/generate-typert-contract.ts --check"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-terminal-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-attachment-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-file-upload": "0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title": "0.2.2-rc.1",
    "@deepseek-ai/dsh-shell-env": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-bash": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.1",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "ajv": "8.17.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  }
}

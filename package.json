{
  "name": "tokenworks-mobile",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "host/remote-control"
  ],
  "scripts": {
    "dev": "python3 tools/dev/local.py start",
    "dev:probe": "node tools/dev/smoke.mjs",
    "dev:status": "python3 tools/dev/local.py status",
    "dev:stop": "python3 tools/dev/local.py stop",
    "build": "npm run build --workspaces",
    "contracts:typert": "tsx tools/generate-typert-contract.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test host/remote-control/tests/*.test.ts",
    "verify": "npm run contracts:typert:check && npm run check && npm run build",
    "test:android": "cd android && ./gradlew check",
    "test:android:core": "cd android && ./gradlew -PjvmOnly=true check",
    "contracts:typert:check": "tsx tools/generate-typert-contract.ts --check"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.1",
    "ajv": "8.17.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  }
}
